generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Topic {
  id        String     @id @default(cuid())
  name      String     @unique
  questions Question[]
  matches   Match[]
}

model Question {
  id              String  @id @default(cuid())
  topicId         String
  text            String  @default("")
  imageUrl        String?
  optionA         String  @default("")
  optionB         String  @default("")
  optionC         String  @default("")
  optionD         String  @default("")
  optionAImageUrl String?
  optionBImageUrl String?
  optionCImageUrl String?
  optionDImageUrl String?
  correctOption   String
  topic           Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

model User {
  id                         String    @id @default(cuid())
  email                      String    @unique
  username                   String    @unique
  password                   String?
  googleId                   String?   @unique
  phone                      String?   @unique
  phoneVerified              Boolean   @default(false)
  phoneOtpHash               String?
  phoneOtpExpiresAt          DateTime?
  phoneOtpSentAt             DateTime?
  phoneOtpAttempts           Int       @default(0)
  emailVerified              Boolean   @default(false)
  verificationToken          String?   @unique
  verificationTokenExpiresAt DateTime?
  emailOtpHash               String?
  emailOtpExpiresAt          DateTime?
  emailOtpSentAt             DateTime?
  emailOtpAttempts           Int       @default(0)
  wins                       Int       @default(0)
  losses                     Int       @default(0)
  isPro                      Boolean   @default(false)
  createdAt                  DateTime  @default(now())

  matchesAsPlayer1 Match[]        @relation("Player1")
  matchesAsPlayer2 Match[]        @relation("Player2")
  winsAsWinner     Match[]        @relation("Winner")
  matchAnswers     MatchAnswer[]
}

model Match {
  id           String   @id @default(cuid())
  topicId      String
  player1Id    String?
  player2Id    String?
  guestName1   String?
  guestName2   String?
  player1Score Int
  player2Score Int
  winnerId     String?
  isDraw       Boolean  @default(false)
  forfeit      Boolean  @default(false)
  createdAt    DateTime @default(now())

  topic   Topic         @relation(fields: [topicId], references: [id])
  player1 User?         @relation("Player1", fields: [player1Id], references: [id])
  player2 User?         @relation("Player2", fields: [player2Id], references: [id])
  winner  User?         @relation("Winner", fields: [winnerId], references: [id])
  answers MatchAnswer[]
}

model MatchAnswer {
  id            String  @id @default(cuid())
  matchId       String
  userId        String
  questionIndex Int
  elapsedMs     Int
  isCorrect     Boolean
  points        Int
  selectedIndex Int?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([userId])
}
