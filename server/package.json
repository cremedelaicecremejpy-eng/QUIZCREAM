{
  "name": "quizcream-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma generate && node prisma/seed.js",
    "db:setup": "prisma migrate dev && prisma generate && node prisma/seed.js",
    "db:studio": "prisma studio",
