# Copy this file to .env and fill in your values.

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require"

# Any long random string for login tokens (change this!)
JWT_SECRET="change-me-to-a-long-random-string"

# Public app URL (used in verification email links)
APP_URL="https://www.quticks.com"
APP_NAME="Quticks"

# Google Cloud OAuth — Web client ID (for Sign in with Google button)
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Email verification via Resend — https://resend.com
# Without this key, new accounts skip email verification (dev only).
RESEND_API_KEY="re_xxxxxxxx"
# After verifying quticks.com in Resend, use your domain sender:
EMAIL_FROM="Quticks <hello@quticks.com>"

# Phone OTP — global SMS via Twilio (https://www.twilio.com)
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID="ACxxxxxxxx"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
# Used when users enter a 10-digit number without country code (India = 91)
DEFAULT_COUNTRY_CODE="91"

# Optional: cheaper India OTP via Fast2SMS (https://www.fast2sms.com)
# Use SMS_PROVIDER=auto to send +91 via Fast2SMS and other countries via Twilio.
# FAST2SMS_API_KEY="your-fast2sms-api-key"

PORT=3001
