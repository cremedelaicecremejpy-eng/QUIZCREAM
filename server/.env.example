# Copy this file to .env and fill in your values.

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require"

# Any long random string for login tokens (change this!)
JWT_SECRET="change-me-to-a-long-random-string"

# Public app URL (used in verification email links)
APP_URL="http://localhost:3001"

# Google Cloud OAuth — Web client ID (for Sign in with Google button)
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Email verification via Resend — https://resend.com
# Without this key, new accounts skip email verification (dev only).
RESEND_API_KEY="re_xxxxxxxx"
# For testing, use Resend's sandbox sender. After verifying your domain, use e.g.:
# EMAIL_FROM="QUIZCREAM <hello@yourdomain.com>"
EMAIL_FROM="QUIZCREAM <onboarding@resend.dev>"

PORT=3001
