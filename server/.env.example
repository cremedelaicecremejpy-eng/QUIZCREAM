# Copy this file to .env and fill in your values.

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require"

# Any long random string for login tokens (change this!)
JWT_SECRET="change-me-to-a-long-random-string"

# Google Cloud OAuth — Web client ID (for Sign in with Google button)
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

PORT=3001
